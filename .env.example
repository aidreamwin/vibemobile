# VibeMobile Docker 部署示例配置

# 服务端口（默认 3000）
PORT=3000

# 固定的登录 PIN（如留空则系统会在启动时随机生成 16 位强密码，含大小写字母、数字与符号，并打印在日志中）
# VIBEMOBILE_PIN=123456

# 禁用登录鉴权（警告：设为 true 则关闭 PIN 验证，任何能连通端口的人都可以操控容器）
# VIBEMOBILE_NO_AUTH=false

# 挂载到容器内 /app/workspace 的宿主机项目路径（默认当前目录）
HOST_WORKSPACE_DIR=.

# 容器内代理可操作的根目录白名单（对应容器内路径，Codex 和 Claude 共用）
VIBEMOBILE_ROOTS=/app/workspace

# 是否开启终端直连功能（on / off）
VIBEMOBILE_TERMINAL=on

# shell 进程在无人连接后活多久才被回收，毫秒（默认 1800000 = 30 分钟）。
# 切页面、刷新、断网都不会结束 shell —— 只有「没人连着」再满这段时间才会。
# VIBEMOBILE_TERMINAL_IDLE_MS=1800000

# 日志级别 (info / debug / silent)
VIBEMOBILE_LOG=info

# 如果需要连外部已有的 codex app-server，可以配置此项：
# CODEX_WS_URL=ws://host.docker.internal:8788
