{
  "name": "vibemobile",
  "version": "0.1.0",
  "private": true,
  "description": "Mobile web remote control for Codex and Claude Code coding agents",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node scripts/dev.mjs --only=server",
    "dev:web": "node scripts/dev.mjs --only=web",
    "build": "npm run build --workspace=@vibemobile/web",
    "start": "npm run start --workspace=@vibemobile/server",
    "dev:hub": "node --import tsx apps/server/src/distributed/hub.ts",
    "dev:runner": "node --import tsx apps/server/src/distributed/runner.ts",
    "start:hub": "node apps/server/dist/distributed/hub.js",
    "start:runner": "node apps/server/dist/distributed/runner.js",
    "build:all": "npm run build --workspace=@vibemobile/server && npm run build --workspace=@vibemobile/web",
    "smoke": "npm run smoke --workspace=@vibemobile/server",
    "gen:codex-types": "codex app-server generate-ts --out packages/protocol/src/generated --experimental",
    "gen:hub-certs": "node scripts/generate-hub-certs.mjs",
    "release": "node scripts/release.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "npm run typecheck --workspace=@vibemobile/server && npm run typecheck --workspace=@vibemobile/web",
    "test": "npm run test --workspace=@vibemobile/server && npm run test --workspace=@vibemobile/web",
    "test:coverage": "npm run test:coverage --workspace=@vibemobile/server && npm run test:coverage --workspace=@vibemobile/web",
    "test:approval": "tsx apps/server/scripts/test-approval.ts",
    "test:hub": "tsx apps/server/scripts/test-hub.ts",
    "test:terminal": "tsx apps/server/scripts/test-terminal.ts",
    "smoke:browser": "node apps/web/scripts/smoke-browser.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@openai/codex": "0.162.1",
    "vite": "^6.4.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "esbuild@0.25.12": true,
    "node-pty@1.1.0": true
  }
}
